{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable location definition, version1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "units",
    "plan",
    "underlay",
    "builder",
    "coordinateFrame",
    "doorStates",
    "additions",
    "referencesPath",
    "cameraPresetsPath",
    "promptTemplates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "units": {
      "const": "meters"
    },
    "pathBase": {
      "const": "repository-root"
    },
    "plan": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative path, with no parent traversal."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "underlay": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Repository-relative path, with no parent traversal."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "builder": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Repository-relative path, with no parent traversal."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Repository-relative path, with no parent traversal."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "coordinateFrame": {
      "type": "object"
    },
    "doorStates": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 120
      }
    },
    "additions": {
      "type": "object"
    },
    "referencesPath": {
      "type": "string"
    },
    "cameraPresetsPath": {
      "type": "string"
    },
    "promptTemplates": {
      "type": "object",
      "required": [
        "still",
        "cubemap"
      ],
      "properties": {
        "still": {
          "type": "string"
        },
        "cubemap": {
          "type": "string"
        }
      }
    }
  },
  "description": "The CLI additionally verifies filesystem containment and SHA256 identities. House geometry follows the builder plan contract."
}
